    for session in plan:
        if not re.fullmatch(r'[A-Za-z0-9_-]{1,55}',session.get('label','')):p.error('Invalid scene label')
        for phase in session['phases']:
            if not re.fullmatch(r'[A-Za-z0-9_-]{1,55}',phase.get('label','')) or not 1<=phase.get('seconds',0)<=300:p.error('Invalid phase label/duration')
        session.setdefault('settings',{})['r_gl1_world_arrays']=1
        session.setdefault('require_cvars',{})['r_gl1_world_arrays']=1
        # DF_NO_FRIENDLY_FIRE only applies to teammates. Model-team mode
        # puts all four benchmark soldiers on the same team. The current
        # game checks OnSameTeam in co-op too, so keep model teams there too.
        flags=256 | 128
        session['settings']['dmflags']=flags
        session['require_cvars']['dmflags']=flags
        if 'prepare_deathmatch' in session:session['prepare_deathmatch']['god']=a.god
        if a.god and not session.get('dm') and not any(re.fullmatch(r'pp_test_slot [0-3] god', c) for phase in session['phases'] for c in phase.get('commands',[])):
            armed=next((phase for phase in session['phases'] if any('give Machinegun' in c for c in phase.get('commands',[]))),None)
            if armed:armed['commands']=[f'pp_test_slot {slot} god' for slot in range(4)]+armed['commands']
        if not a.god:
            for phase in session['phases']:
                phase['commands']=[c for c in phase.get('commands',[]) if not re.fullmatch(r'pp_test_slot [0-3] god',c)]
    if len({s['label'] for s in plan})!=len(plan):p.error('Scene labels must be unique')
    if a.export_scene:
        with a.export_scene.open('x') as f:json.dump(plan,f,indent=2);f.write('\n')
        print('Edit positions/commands in '+str(a.export_scene));return 0
    if target=='pi' and not is_pi():p.error('Run --target pi on the Pi; use tools/performance/bench-pi to launch it over SSH from this PC')
    driver=HERE/('input_driver.so' if target=='pi' else 'input_driver-pc.so')
    for file,expected in [(runtime/'quake2',ENGINE if target=='pi' else PC_ENGINE),(runtime/'ref_gl1.so',RENDERER if target=='pi' else PC_RENDERER),(driver,DRIVER if target=='pi' else PC_DRIVER)]:
        if sha(file)!=expected:p.error('Input-driver ABI compatibility not established for '+str(file)+'. Map edits are supported; rebuild/revalidate the helper after an engine/renderer update.')
    lock=open(Path(tempfile.gettempdir())/f'pp-bench-{os.getuid()}.lock','a')
    try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
    except BlockingIOError:p.error('Another benchmark is already running')
    if subprocess.run(['pgrep','-x','quake2'],capture_output=True).returncode==0:p.error('Close the running game first. This command launches a separate test session.')
    result_root=HERE/'results' if target=='pi' else REPO/'build/pc-bench-results'
    out=(a.output or result_root/datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')).resolve()
    for protected in (runtime,a.saves.resolve(),HERE/'lib'):
        if out==protected or out.is_relative_to(protected) or protected.is_relative_to(out):p.error('Results must be outside runtime, real saves and tool libraries')
    if out.exists():p.error('Output already exists; choose a new directory')
    if target=='pi' and not out.is_relative_to(Path('/data').resolve()):p.error('Use an --output directory under /data. The Pi home/root and /tmp are RAM-backed and distort memory/performance measurements.')
    out.parent.mkdir(parents=True,exist_ok=True)
    required=sum(f.stat().st_size for f in runtime.rglob('*') if f.is_file())+32*1024*1024
    if shutil.disk_usage(out.parent).free < required:p.error('Insufficient free space for the private runtime. Choose an --output directory on /data, not the RAM-backed home/root overlay.')
    invocation=dict(map=a.map,target=target,display_backend='headless-software' if a.headless else 'native',mode=mode,quality=a.quality,preset=a.preset,god_mode=a.god,protection='friendly fire disabled; same-model team',map_candidate_sha256=hashlib.sha256(data).hexdigest(),map_file=str(a.map_file) if a.map_file else None,addon=str(a.addon) if a.addon else None,command=sys.argv,players=4,framebuffer=size,runtime=str(runtime))
    if a.compare:
        old=json.loads(a.compare.read_text());compare_context(old['invocation'],invocation)
        if old['invocation']['map']!=a.map:p.error('Comparison map differs')
    # Worker releases Python asset buffers before launch. The parent also frees
    # its map before waiting, to avoid retaining a large map on the 512 MiB Pi.
    del data,ents,available
    import gc,ctypes
    gc.collect();ctypes.CDLL(None).malloc_trim(0)
    with tempfile.TemporaryDirectory(prefix='pp-bench-plan-') as temp:
        planpath=Path(temp)/'plan.json';planpath.write_text(json.dumps(plan,indent=2)+'\n')
        command=[sys.executable,str(HERE/'lib/run_suite.py'),'--output',str(out),'--plan',str(planpath),'--shim',str(driver),'--runtime-source',str(runtime),'--saves',str(a.saves.resolve()),'--target',target,'--size',size]
        env=dict(os.environ)
        if a.headless:
            if not shutil.which('xvfb-run'):p.error('--headless needs xvfb-run')
            command=['xvfb-run','-a','-s',f'-screen 0 {max(width,1024)}x{max(height,1024)}x24',*command]
            env['LIBGL_ALWAYS_SOFTWARE']='1'
        if a.map_file:command+=['--map-file',str(a.map_file)]
        if a.addon:command+=['--addon',str(a.addon)]
        print('Launching four local players. Leave controls alone; Ctrl+C stops the test.\nResults: '+str(out),flush=True)
        worker=subprocess.Popen(command,start_new_session=True,env=env)
        try:code=worker.wait()
        except KeyboardInterrupt:
            if a.headless:os.killpg(worker.pid,signal.SIGINT)
            else:worker.send_signal(signal.SIGINT)
            print('\nStopping test and restoring the shell; please wait.',flush=True)
            code=worker.wait()
        try:
            valid=report(out,invocation,a.compare)
        except Exception as e:
            print('No complete report: '+str(e)+'; retained raw output: '+str(out),file=sys.stderr);return 1
        if code==0 and valid and not a.keep_runtime:shutil.rmtree(out/'runtime')
        return 0 if code==0 and valid else 1

if __name__=='__main__':
    try:sys.exit(main())
    except (ValueError,OSError,RuntimeError) as e:print('Benchmark error: '+str(e),file=sys.stderr);sys.exit(1)
